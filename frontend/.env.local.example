# Base URL of the deployed backend HTTP API (from `sam deploy` outputs),
# e.g. https://abc123.execute-api.ap-south-1.amazonaws.com
NEXT_PUBLIC_API_BASE_URL=

# Cognito Identity Pool (unauthenticated/anonymous access only) used to
# issue a real Session_Identity per browser instead of a self-generated
# UUID. From `sam deploy` outputs: StudentIdentityPoolId, StudentIdentityPoolRegion.
# Optional: if left blank, the app falls back to a locally generated UUID.
NEXT_PUBLIC_COGNITO_IDENTITY_POOL_ID=
NEXT_PUBLIC_COGNITO_REGION=
